{
  "schema_version": "1.0",
  "template_id": "industry.saas.v1",
  "template_version": "1.0",
  "industry_type": "saas",
  "supported_language": "en",
  "candidate_only": true,
  "description": "English-language B2B SaaS diagnosis candidates.",
  "applicable_conversion_goals": ["demo", "free_trial", "signup", "contact_sales"],
  "generator_families": ["llms", "jsonld", "snippets", "outlines"],
  "required_facts": [
    {"id": "saas.fact.category", "label": "Canonical category and product definition", "evidence_required": true},
    {"id": "saas.fact.pricing", "label": "Pricing, plan and free-trial terms", "evidence_required": true},
    {"id": "saas.fact.integrations", "label": "Supported integrations and limitations", "evidence_required": true},
    {"id": "saas.fact.security", "label": "Security and compliance claims with source and scope", "evidence_required": true},
    {"id": "saas.fact.alternatives", "label": "Alternative and comparison boundaries", "evidence_required": true},
    {"id": "saas.fact.customer_proof", "label": "Approved customer names, outcomes and case-study URLs", "evidence_required": true},
    {"id": "saas.fact.conversion", "label": "Demo, signup and trial conversion paths", "evidence_required": true},
    {"id": "saas.fact.help_center", "label": "Help Center ownership, version and canonical URLs", "evidence_required": true}
  ],
  "question_patterns": [
    {"id": "saas.q.category", "group": "category", "pattern": "What is {brand} and which {product_line} category does it belong to?", "intent": "definition", "priority": "P0"},
    {"id": "saas.q.pricing", "group": "pricing", "pattern": "How much does {brand} cost and does it offer a free trial or demo?", "intent": "commercial", "priority": "P1"},
    {"id": "saas.q.integration", "group": "integrations", "pattern": "Which tools does {brand} integrate with for {product_line}?", "intent": "compatibility", "priority": "P1"},
    {"id": "saas.q.security", "group": "security", "pattern": "How does {brand} handle security, privacy and compliance?", "intent": "risk", "priority": "P0"},
    {"id": "saas.q.alternative", "group": "alternatives", "pattern": "What are the best alternatives to {brand} for {product_line}?", "intent": "alternative", "priority": "P1"},
    {"id": "saas.q.comparison", "group": "comparison", "pattern": "How does {brand} compare with {competitor}?", "intent": "comparison", "priority": "P1"},
    {"id": "saas.q.proof", "group": "customer_proof", "pattern": "Which companies use {brand}, and what verified outcomes are published?", "intent": "proof", "priority": "P1"},
    {"id": "saas.q.help", "group": "help_center", "pattern": "Do the {brand} website and Help Center describe the same features and limits?", "intent": "consistency", "priority": "P1"}
  ],
  "approval_defaults": [
    {"id": "saas.approval.fact", "roles": ["brand_fact_approver"], "required": true, "applies_to": ["definition", "numbers", "customer_name", "compliance"]},
    {"id": "saas.approval.content", "roles": ["content_owner", "reviewer"], "required": true, "applies_to": ["page", "faq", "comparison"]},
    {"id": "saas.approval.technical", "roles": ["web_owner"], "required": true, "applies_to": ["jsonld", "technical_snippet"]}
  ],
  "acceptance_defaults": [
    {"id": "saas.accept.asset", "check": "asset.exists", "required": true},
    {"id": "saas.accept.approval", "check": "approval.required", "required": true},
    {"id": "saas.accept.url", "check": "deployment.url_2xx", "required": true},
    {"id": "saas.accept.text", "check": "deployment.contains_text", "required": true},
    {"id": "saas.accept.software_jsonld", "check": "deployment.jsonld_type", "target": "SoftwareApplication", "required": true},
    {"id": "saas.accept.facts", "check": "facts.no_rejected_claims", "required": true}
  ],
  "asset_templates": [
    {"id": "saas.asset.category", "label": "Category page", "asset_type": "category_page", "generator_family": "outlines", "approval_default_ids": ["saas.approval.fact", "saas.approval.content"], "acceptance_default_ids": ["saas.accept.asset", "saas.accept.approval", "saas.accept.url", "saas.accept.text", "saas.accept.facts"]},
    {"id": "saas.asset.alternative", "label": "Alternative page", "asset_type": "alternative_page", "generator_family": "outlines", "approval_default_ids": ["saas.approval.fact", "saas.approval.content"], "acceptance_default_ids": ["saas.accept.asset", "saas.accept.approval", "saas.accept.url", "saas.accept.text", "saas.accept.facts"]},
    {"id": "saas.asset.comparison", "label": "Comparison page", "asset_type": "comparison_page", "generator_family": "outlines", "approval_default_ids": ["saas.approval.fact", "saas.approval.content"], "acceptance_default_ids": ["saas.accept.asset", "saas.accept.approval", "saas.accept.url", "saas.accept.text", "saas.accept.facts"]},
    {"id": "saas.asset.integration", "label": "Integration page", "asset_type": "integration_page", "generator_family": "outlines", "approval_default_ids": ["saas.approval.fact", "saas.approval.content"], "acceptance_default_ids": ["saas.accept.asset", "saas.accept.approval", "saas.accept.url", "saas.accept.text"]},
    {"id": "saas.asset.security_faq", "label": "Security FAQ", "asset_type": "security_faq", "generator_family": "snippets", "approval_default_ids": ["saas.approval.fact", "saas.approval.content"], "acceptance_default_ids": ["saas.accept.asset", "saas.accept.approval", "saas.accept.url", "saas.accept.text", "saas.accept.facts"]},
    {"id": "saas.asset.customer_proof", "label": "Customer proof block", "asset_type": "customer_proof_block", "generator_family": "snippets", "approval_default_ids": ["saas.approval.fact", "saas.approval.content"], "acceptance_default_ids": ["saas.accept.asset", "saas.accept.approval", "saas.accept.text", "saas.accept.facts"]},
    {"id": "saas.asset.software_jsonld", "label": "SoftwareApplication JSON-LD", "asset_type": "software_application_jsonld", "generator_family": "jsonld", "approval_default_ids": ["saas.approval.fact", "saas.approval.technical"], "acceptance_default_ids": ["saas.accept.asset", "saas.accept.approval", "saas.accept.url", "saas.accept.software_jsonld", "saas.accept.facts"]}
  ],
  "diagnosis_rules": [
    {"id": "saas.rule.category", "case_type": "content_gap", "match": {"keywords": ["definition", "category", "entity", "disambiguation"]}, "required_evidence_types": ["page", "audit_item", "fact"], "question_pattern_ids": ["saas.q.category"], "asset_template_ids": ["saas.asset.category", "saas.asset.software_jsonld"], "reason": "Category ambiguity weakens entity understanding."},
    {"id": "saas.rule.pricing", "case_type": "fact_error", "match": {"keywords": ["pricing", "price", "trial", "demo"]}, "required_evidence_types": ["page", "ai_answer", "fact"], "question_pattern_ids": ["saas.q.pricing"], "asset_template_ids": ["saas.asset.category"], "reason": "Commercial facts must match the current offer."},
    {"id": "saas.rule.integration", "case_type": "content_gap", "match": {"keywords": ["integration", "connect", "compatibility"]}, "required_evidence_types": ["page", "fact"], "question_pattern_ids": ["saas.q.integration"], "asset_template_ids": ["saas.asset.integration"], "reason": "Integration claims need product-specific evidence."},
    {"id": "saas.rule.security", "case_type": "fact_error", "match": {"keywords": ["security", "privacy", "compliance", "soc 2", "gdpr"]}, "required_evidence_types": ["page", "fact", "human_material"], "question_pattern_ids": ["saas.q.security"], "asset_template_ids": ["saas.asset.security_faq"], "reason": "Security and compliance claims require scope and evidence."},
    {"id": "saas.rule.comparison", "case_type": "content_gap", "match": {"keywords": ["alternative", "comparison", "competitor"]}, "required_evidence_types": ["ai_answer", "cited_domain", "fact"], "question_pattern_ids": ["saas.q.alternative", "saas.q.comparison"], "asset_template_ids": ["saas.asset.alternative", "saas.asset.comparison"], "reason": "Comparison content must distinguish verified differences from marketing claims."},
    {"id": "saas.rule.proof", "case_type": "external_evidence_gap", "match": {"keywords": ["customer", "case study", "proof", "testimonial"]}, "required_evidence_types": ["page", "cited_domain", "fact"], "question_pattern_ids": ["saas.q.proof"], "asset_template_ids": ["saas.asset.customer_proof"], "reason": "Customer evidence must be approved and independently traceable."},
    {"id": "saas.rule.help_center", "case_type": "fact_error", "match": {"keywords": ["help center", "documentation", "docs", "outdated"]}, "required_evidence_types": ["page", "audit_item"], "question_pattern_ids": ["saas.q.help"], "asset_template_ids": ["saas.asset.integration", "saas.asset.security_faq"], "reason": "Website and support documentation must not conflict."}
  ],
  "risk_expressions": [
    {"id": "saas.risk.best", "pattern": "best|#1|leading", "risk": "high", "reason": "Unqualified superiority claim", "required_action": "Provide dated comparative evidence or remove."},
    {"id": "saas.risk.compliance", "pattern": "fully compliant|guaranteed compliant", "risk": "high", "reason": "Compliance scope may be overstated", "required_action": "Require Brand Fact Approver and scope evidence."},
    {"id": "saas.risk.security", "pattern": "100% secure|unhackable", "risk": "high", "reason": "Absolute security promise", "required_action": "Reject absolute wording."},
    {"id": "saas.risk.customer", "pattern": "trusted by|used by", "risk": "high", "reason": "Customer-name or adoption claim", "required_action": "Require written approval and source URL."},
    {"id": "saas.risk.savings", "pattern": "save [0-9]+%|increase .* by [0-9]+%", "risk": "high", "reason": "Quantified outcome", "required_action": "Bind methodology, population and date."}
  ]
}
